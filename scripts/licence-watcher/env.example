# EMEA licence watcher — local secrets. Copy to ~/.config/licence-watcher/env and fill in.
#   mkdir -p ~/.config/licence-watcher
#   cp env.example ~/.config/licence-watcher/env && chmod 600 ~/.config/licence-watcher/env
# Salesforce creds are sourced separately from the PROD .env by run-local.sh — not here.

# --- Slack (required for run/digest to post) ---
SLACK_BOT_TOKEN=xoxb-...
# Defaults below are already baked into watcher.py; override only if they change.
# LICENCE_FEED_CHANNEL_ID=C0BP0TZTAG7
# LICENCE_PING_USER_ID=U0BLN3B8TCZ

# --- Notion watchlist (required to honour the loud-ping watchlist) ---
NOTION_TOKEN=secret_...
# LICENCE_WATCHLIST_DS_ID=1d72ac2d-853f-43ad-b7dc-a505a210c534

# --- Todoist (optional; only used for watchlist rows with "Create Todoist" ticked) ---
TODOIST_API_TOKEN=...

# --- Email digest (SMTP + app password) ---
# The 08:00 digest emails the overnight action list when these are set.
# askadam.cloud is an iCloud+ custom domain, so use Apple's SMTP server.
#   SMTP_USER  = your PRIMARY iCloud address (usually the @icloud.com one) — iCloud
#                authenticates on the account login, not the custom-domain alias.
#   SMTP_PASS  = an app-specific password from appleid.apple.com → Sign-In & Security
#                → App-Specific Passwords (required; your normal password won't work).
#   EMAIL_FROM = adam@askadam.cloud — valid because it's a send-as alias on the account.
LICENCE_SMTP_HOST=smtp.mail.me.com
LICENCE_SMTP_PORT=587
LICENCE_SMTP_USER=you@icloud.com
LICENCE_SMTP_PASS=your-app-specific-password
LICENCE_EMAIL_TO="adam.brown@altra.cloud, Sandra.Murray@altra.cloud"
LICENCE_EMAIL_FROM="adam@askadam.cloud"

# --- Support Central: licence expiry (renewal follow-up in the digest) ---
# The digest's "Licence renewals" section pulls RenewalDate per deployment from
# Support Central and joins it to Salesforce for the EMEA filter + contacts.
# Provide the key directly, or point SUPC_KEY_FILE at the key file (may be HTML).
# SUPPORT_CENTRAL_API_KEY=drm_...
# SUPC_KEY_FILE=~/Developer/Altra/drm-support-central/key.txt.html   # default path
# SUPC_BASE_URL=https://app-drm-prd-ase-supc-api.azurewebsites.net   # default
# LICENCE_EXPIRY_AHEAD_DAYS=30    # "expiring": renews within N days
# LICENCE_EXPIRY_BEHIND_DAYS=30   # "expired": renewed within the last N days
